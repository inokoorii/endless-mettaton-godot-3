[input_devices]

pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="battle/heart"
2d_physics/layer_2="battle/heart/bullet"
2d_physics/layer_3="battle/heart/bullet_hurtbox"
2d_physics/layer_4="battle/enemy/bullet"
2d_physics/layer_5="battle/enemy/bullet_hurtbox"
2d_physics/layer_6="battle/board"

[physics]

common/enable_pause_aware_picking=true

[rendering]

2d/snapping/use_gpu_pixel_snap=true
vram_compression/import_etc=true
2d/options/ninepatch_mode=0
environment/default_clear_color=Color( 0.301961, 0.301961, 0.301961, 1 )
environment/default_environment="res://default_env.tres"

[statistics]

force_include=PoolStringArray(  )
