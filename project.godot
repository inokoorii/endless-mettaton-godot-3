; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Node2D",
"class": "Battle",
"language": "GDScript",
"path": "res://source/battle/scenes/battle/battle.gd"
}, {
"base": "Node2D",
"class": "BattleBoard",
"language": "GDScript",
"path": "res://source/battle/gameplay/board/board.gd"
}, {
"base": "Area2D",
"class": "BattleEnemyBullet",
"language": "GDScript",
"path": "res://source/battle/gameplay/enemy_bullet/enemy_bullet.gd"
}, {
"base": "Area2D",
"class": "BattleEnemyBulletHurtbox",
"language": "GDScript",
"path": "res://source/battle/gameplay/enemy_bullet/enemy_bullet_hurtbox.gd"
}, {
"base": "KinematicBody2D",
"class": "BattleHeart",
"language": "GDScript",
"path": "res://source/battle/gameplay/player/heart/heart.gd"
}, {
"base": "Area2D",
"class": "BattleHeartBullet",
"language": "GDScript",
"path": "res://source/battle/gameplay/player_bullet/heart_bullet/heart_bullet.gd"
}, {
"base": "Area2D",
"class": "BattleHeartBulletHurtbox",
"language": "GDScript",
"path": "res://source/battle/gameplay/player_bullet/heart_bullet_hurtbox.gd"
}, {
"base": "Object",
"class": "DirectoryIndexer",
"language": "GDScript",
"path": "res://source/core/utils/directory_indexer.gd"
}, {
"base": "Object",
"class": "ErrorUtils",
"language": "GDScript",
"path": "res://source/core/utils/error_utils.gd"
}, {
"base": "Control",
"class": "MainScene",
"language": "GDScript",
"path": "res://source/game/main_scene/main_scene.gd"
}, {
"base": "Object",
"class": "MovementUtils",
"language": "GDScript",
"path": "res://source/game/utils/movement_utils.gd"
}, {
"base": "Object",
"class": "PathUtils",
"language": "GDScript",
"path": "res://source/core/utils/path_utils.gd"
}, {
"base": "Resource",
"class": "SaveFile",
"language": "GDScript",
"path": "res://source/game/save/save_file.gd"
}, {
"base": "Resource",
"class": "SettingsFile",
"language": "GDScript",
"path": "res://source/game/settings/settings_file.gd"
}, {
"base": "Node2D",
"class": "SlicedSprite",
"language": "GDScript",
"path": "res://source/shared/effects/sliced_sprite/sliced_sprite.gd"
} ]
_global_script_class_icons={
"Battle": "",
"BattleBoard": "",
"BattleEnemyBullet": "",
"BattleEnemyBulletHurtbox": "",
"BattleHeart": "",
"BattleHeartBullet": "",
"BattleHeartBulletHurtbox": "",
"DirectoryIndexer": "",
"ErrorUtils": "",
"MainScene": "",
"MovementUtils": "",
"PathUtils": "",
"SaveFile": "",
"SettingsFile": "",
"SlicedSprite": ""
}

[application]

config/name="ENDLESS METTATON"
run/main_scene="res://source/game/main_scene/main_scene.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="inokoorii/games/endless-mettaton"
run/delta_sync_after_draw=true
boot_splash/show_image=false
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://icon.png"

[autoload]

AudioManager="*res://source/core/audio_manager/audio_manager.tscn"
BattleGlobals="*res://source/battle/battle_globals.gd"
GameGlobals="*res://source/game/game_globals.gd"
SaveFileManager="*res://source/game/save/save_file_manager.gd"
SettingsFileManager="*res://source/game/settings/settings_file_manager.gd"

[debug]

gdscript/warnings/unused_variable=false
gdscript/warnings/unused_argument=false
gdscript/warnings/unused_signal=false

[display]

window/size/width=640
window/size/height=480
window/size/resizable=false
window/dpi/allow_hidpi=true
window/stretch/mode="viewport"
window/stretch/aspect="expand"

[editor]

scene_naming=2

[editor_plugins]

enabled=PoolStringArray( "res://addons/Todo_Manager/plugin.cfg", "res://addons/folder_nodes/plugin.cfg", "res://addons/project-statistics/plugin.cfg" )

[gui]

common/drop_mouse_on_gui_input_disabled=true

[importer_defaults]

texture={
"compress/bptc_ldr": 0,
"compress/hdr_mode": 0,
"compress/lossy_quality": 0.7,
"compress/mode": 0,
"compress/normal_map": 0,
"detect_3d": false,
"flags/anisotropic": false,
"flags/filter": false,
"flags/mipmaps": false,
"flags/repeat": 0,
"flags/srgb": 2,
"process/HDR_as_SRGB": false,
"process/fix_alpha_border": true,
"process/invert_color": false,
"process/normal_map_invert_y": false,
"process/premult_alpha": false,
"size_limit": 0,
"stream": false,
"svg/scale": 1.0
}

